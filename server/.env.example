# Required — Neon serverless Postgres connection string
# Get it from: https://neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional — set this to your actual Vercel deployment URL so pixel URLs
# point to the right place (Vercel sets VERCEL_URL automatically, but only
# on the current deployment; SERVER_URL lets you pin a stable custom domain).
# SERVER_URL=https://your-app.vercel.app
